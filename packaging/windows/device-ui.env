# =============================================================================
# MeetingBox for Windows - configuration
# Loaded at startup. Lines are KEY=VALUE. '#' starts a comment.
# Real environment variables override anything set here.
# Installed to:  %PROGRAMDATA%\Nexa\device-ui.env  (edit then relaunch)
# =============================================================================

# --- Backend (cloud) -----------------------------------------------------
# Windows build uses the dedicated win. subdomain; the Linux appliance keeps
# the bare meetingboxai.lucratechsol.com backend (see mini-pc/env).
BACKEND_URL=https://win.meetingboxai.lucratechsol.com
BACKEND_WS_URL=wss://win.meetingboxai.lucratechsol.com/ws
DASHBOARD_URL=https://win.meetingboxai.lucratechsol.com/

# --- Audio upload --------------------------------------------------------
UPLOAD_AUDIO_ON_STOP=1
UPLOAD_AUDIO_API_URL=https://win.meetingboxai.lucratechsol.com/api/meetings/upload-audio
UPLOAD_AUDIO_TIMEOUT_SECONDS=7200

# --- Window (fixed windowed size for the Windows desktop app) ---------------
# The Windows desktop app opens as a normal, non-resizable window at a fixed
# pixel size that comfortably fits common laptop screens (1366x768 and up).
# main.py clamps this to the usable desktop area so it can never end up taller
# than the screen. Adjust these if you want a larger/smaller window.
DISPLAY_WIDTH=1120
DISPLAY_HEIGHT=680
# (PHYSICAL-size auto-detection is used only on non-Windows desktop builds; the
# values below are ignored on Windows.)
DISPLAY_PHYSICAL_WIDTH_CM=15.01
DISPLAY_PHYSICAL_HEIGHT_CM=9.53
# DISPLAY_PPCM=55.65
# Desktop app runs windowed (not kiosk) and shows the mouse cursor for clicks.
FULLSCREEN=0
SHOW_MOUSE_CURSOR=1

# --- Audio capture (Windows uses PortAudio via sounddevice) --------------
AUDIO_CAPTURE_BACKEND=sounddevice
AUDIO_OUTPUT_DEVICE=default
# Spawn the bundled nexa-audio.exe capture child (meeting recording).
MEETINGBOX_SPAWN_AUDIO=1

# --- Voice assistant (OpenAI Realtime) -----------------------------------
# The wake word ("Hey Nexa") is detected locally on-device (Vosk +
# PortAudio). On wake, the app requests an ephemeral OpenAI Realtime client
# secret from the backend (POST /api/voice/realtime/session) and connects
# directly to wss://api.openai.com/v1/realtime. No API key lives on the PC,
# and there is NO LiveKit/Pipecat involvement on the device.
#
# Realtime is ON by default; no flag required. Optional overrides:
#   MEETINGBOX_WAKE_LOCAL_VOICE_ONLY=1  -> never start Realtime (local Vosk only)
#   REALTIME_WARM_STANDBY=0             -> disable the pre-warmed session
# (Realtime must also be enabled server-side: backend OPENAI_API_KEY +
#  MEETINGBOX_REALTIME_VOICE_ENABLED. Those are server config, not set here.)
#
# --- Echo cancellation (open-speaker full-duplex barge-in) ---------------
# ===========================================================================
#  !!! READ THIS BEFORE YOU EDIT THE TWO FLAGS BELOW  (humans + AI agents) !!!
#
#  DO NOT set REALTIME_PREFER_OS_AEC or REALTIME_OS_AEC back to 0.
#  DO NOT "restore the Speex default" / "turn the smart engines off" here.
#
#  WHY: This build targets a Windows mini-PC with a built-in speaker + mic that
#  are acoustically coupled (the mic physically hears the speaker). The ONLY
#  echo engine that has been validated to work on this hardware is the Windows
#  Voice Capture DSP (OS-grade AEC), enabled below. With it ON, the assistant
#  does not hear its own voice and full-duplex barge-in is instant.
#
#  The plain "PortAudio + Speex + local barge-in" path (all engines = 0) has
#  been tried on this exact device and it REGRESSES: the local energy detector
#  triggers on the assistant's own echo, so the device hears itself, self-
#  interrupts, and loops ("hears its own voice and stops"). WebRTC AEC3 was
#  also tried and regressed (raised the barge-in bar so normal speech stopped
#  interrupting). Both have been ruled out on this hardware — this is not a
#  theoretical preference, it is a repeatedly-reproduced bug.
#
#  The old worry that the OS DSP "goes deaf under playback churn" is handled in
#  code by the silent keep-alive render stream, and if the DSP ever fails to
#  start the session auto-falls-back to Speex at runtime — so leaving these ON
#  is safe. Every time these two flags get reset to 0, the echo bug comes back.
#  If you genuinely think they must change, ask the repo owner FIRST.
#
#  Notes:
#   * Headphones or a USB conference puck also remove echo physically.
#   * If it stops hearing YOU on soft speech: lower REALTIME_VAD_THRESHOLD.
# ===========================================================================
REALTIME_PREFER_OS_AEC=1
REALTIME_OS_AEC=1
REALTIME_WEBRTC_AEC=0
REALTIME_HALF_DUPLEX=auto
REALTIME_LOCAL_BARGE_IN=1
REALTIME_TURN_DETECTION=semantic_vad
REALTIME_TURN_EVIDENCE=0

# --- Uplink codec (mic -> server bandwidth) ------------------------------
# g711_ulaw transcodes the mic leg to G.711 mu-law @ 8 kHz (~64 kbps) instead
# of sending 24 kHz PCM16 (~512 kbps). The lower, predictable upstream usage
# prevents audio queueing on normal Wi-Fi, which otherwise delays end-of-turn
# detection and makes replies feel slow. The assistant's downlink voice remains
# full-quality PCM either way. Use pcm16 only on a measured, stable connection
# where the extra transcription fidelity is worth the 8x upstream bandwidth.
#   REALTIME_UPLINK_CODEC=g711_ulaw   # g711_ulaw | pcm16
REALTIME_UPLINK_CODEC=g711_ulaw
# EXE defaults: digital mic gain 1.0 (unset) and VAD threshold 0.6 (unset). The
# INPUT_GAIN=2.5 / VAD_THRESHOLD=0.85 overrides added for the AEC3/DSP era are
# removed so the Speex path behaves like the EXE. If real speech reads weak in
# the logs on your hardware, nudge REALTIME_INPUT_GAIN up (1.5–2.5).

# --- Turn-taking / how it decides you've finished ------------------------
# This is restored to the shipping EXE's server-driven model — the fast,
# interactive baseline. The server's semantic VAD detects when you've finished
# talking and generates the reply automatically (create_response +
# interrupt_response both on). REALTIME_TURN_EVIDENCE=0 disables the later
# client-authority layer (a manual per-turn response.create + phantom excision)
# that regressed responsiveness: when its per-turn response.create stalled, the
# model went silent and the server eventually closed the session mid-task.
# Half-duplex mic-muting during playback + Speex AEC already stop the echo
# phantoms that layer was built to catch.
#
#   REALTIME_TURN_DETECTION=semantic_vad # semantic_vad | server_vad | auto
#   REALTIME_TURN_EVIDENCE=0             # 0 = EXE server-driven turn-taking;
#                                        # 1 = client-authority evidence layer.
#   REALTIME_VAD_EAGERNESS=medium        # low|medium|high (semantic reply speed).
# Energy-based turn-taking is still available for experiments:
#   REALTIME_TURN_DETECTION=server_vad
#   REALTIME_VAD_THRESHOLD=0.6           # 0..1. Higher = ignore quieter sounds.
#   REALTIME_VAD_SILENCE_MS=500          # silence after you stop before it replies.
#   REALTIME_VAD_PREFIX_MS=300           # audio kept before speech onset.

# --- Wake word sensitivity -----------------------------------------------
# "Hey Nexa" is matched structurally (a "hey" sound followed by a
# "nexa" sound), so accents / mis-hearings like "hey nexus", "hey next",
# "hey necks" still wake on the first try — without waking on the plain word
# mid-conversation.
#   VOICE_ASSISTANT_WAKE_THRESHOLD=0.82 # fuzzy bar for the "nexa" token.
#                                       # Lower (e.g. 0.78) = even easier to wake;
#                                       # raise toward 0.9 if it wakes too easily.

# --- Desktop mic / voice-quality tuning ----------------------------------
# A PC's built-in mic + speakers are acoustically coupled and quieter/noisier
# than the appliance's far-field USB array. These knobs tune the live voice
# path for that. Defaults are sane; uncomment only to fine-tune. After AEC
# (libspeexdsp) + anti-aliased capture, most setups need no changes.
#
#   REALTIME_INPUT_GAIN=1.0       # digital mic gain (1.0=off). Try 1.5-2.5 if
#                                 # the assistant often "doesn't hear" you.
#   REALTIME_BARGE_IN_MIN_RMS=500 # lower = easier to interrupt (desktop default
#                                 # 500). Raise if your own voice/echo self-trips.
#   REALTIME_SPEECH_UPLINK_S=3.0  # how long the mic uplink stays open after the
#                                 # server detects you talking (captures full turn).
#   REALTIME_MIC_TAIL_S=0.5       # echo-mute tail after the assistant stops.
#   REALTIME_VAD_EAGERNESS=medium # low|medium|high|auto (reply speed after you stop).
#   REALTIME_HALF_DUPLEX=auto     # auto|1|0. auto=half-duplex unless a combined
#                                 # echo-isolated mic+speaker puck is detected.
#   AUDIO_INPUT_DEVICE_NAME=      # substring to force a specific mic (e.g. a USB
#                                 # headset) instead of the Windows default.
# Best real-world quality: use a USB headset or conference mic (removes echo
# coupling entirely; the app then runs full-duplex automatically).

# --- Device pairing ------------------------------------------------------
# Leave unset for a fresh install: the app shows the pairing screen and
# writes its own token under %LOCALAPPDATA%\MeetingBox\data\config.
# DEVICE_AUTH_TOKEN=
